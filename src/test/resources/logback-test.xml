<?xml version="1.0" encoding="UTF-8"?>
<!--
  Added by the audit run: Hibernate/Logback default to DEBUG which produces
  tens of thousands of lines for the test suite. This only reduces noise,
  it does not change any test behaviour.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
